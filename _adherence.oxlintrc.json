{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/cards/**",
              "components/display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/inputs/**",
              "components/navigation/**",
              "ui_kits/ghost-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:SJ Pro|Cousine))/i]",
        "message": "Font not provided by the design system. Available: SJ Pro, Cousine."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionSheetAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|onClick|destructive|key|ref|className|style|children)$/]",
        "message": "<ActionSheetAction> doesn't accept that prop. Declared props: label, onClick, destructive."
      },
      {
        "selector": "JSXOpeningElement[name.name='Adornment'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|onClick|label|key|ref|className|style|children)$/]",
        "message": "<Adornment> doesn't accept that prop. Declared props: type, onClick, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Adornment'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:icon|text)$/]",
        "message": "<Adornment> type must be one of 'icon' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AndroidNavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|dark|key|ref|className|style|children)$/]",
        "message": "<AndroidNavBar> doesn't accept that prop. Declared props: type, dark."
