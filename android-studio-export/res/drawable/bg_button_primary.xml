<?xml version="1.0" encoding="utf-8"?>
<!-- Ghost-UI primary button: pill, red fill, pressed state darkens. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_action_primary_pressed" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_action_disabled" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_action_primary" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
</selector>
